# Copy this file to .env and fill in real values. .env is gitignored,
# this template is committed so anyone cloning the project knows which
# settings they need to supply.

# Django cryptographic signing key. Generate your own, never reuse this
# placeholder, and never commit the real value.
SECRET_KEY=replace-with-your-own-long-random-string

# Debug must be False anywhere that is not your own machine. When this
# is False, settings.py switches on the HTTPS, HSTS, secure cookie and
# strict CSP block.
DEBUG=True

# Comma separated list of hostnames allowed to serve this site.
ALLOWED_HOSTS=127.0.0.1,localhost
