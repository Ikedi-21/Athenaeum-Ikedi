# ============================================================
# Athenaeum Ikedi – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# .env is gitignored and must NEVER be committed.
# On Railway, set these as environment variables in the
# Railway dashboard (Settings → Variables).
# ============================================================

# --- Required -------------------------------------------------

# Django cryptographic signing key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# --- Environment ----------------------------------------------

# Set to False in production (Railway). True only on your local machine.
DEBUG=True

# Comma-separated list of hostnames this site answers to.
# Local:    127.0.0.1,localhost
# Railway:  your-app-name.up.railway.app
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated HTTPS origins trusted for CSRF form submissions.
# Required on Railway. Example:
CSRF_TRUSTED_ORIGINS=https://your-app-name.up.railway.app

# --- Database -------------------------------------------------
# Railway provides DATABASE_URL automatically when you add a Postgres plugin.
# Leave empty locally to fall back to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Static & Media -------------------------------------------
# On Railway, set MEDIA_ROOT to a persistent volume mount, e.g. /app/media
# Leave empty locally to use the default <project>/media/ folder.
# MEDIA_ROOT=/app/media
MEDIA_ROOT=

# --- Email (optional, only needed in production) --------------
# Leave empty locally — the console backend will be used instead.
# On Railway, use SendGrid, Mailgun, Brevo, etc.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-app-name.up.railway.app
